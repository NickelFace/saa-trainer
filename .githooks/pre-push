#!/usr/bin/env bash
# Не пускать в main то, что упадёт в CI. Проверки те же, что в workflow,
# и занимают несколько секунд. Обойти при необходимости: git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
printf '\033[1mpre-push: проверяю сборку так же, как это сделает CI\033[0m\n'
bash "$ROOT/scripts/check.sh"
